# Database
DATABASE_URL=
DIRECT_URL=

# Session
SESSION_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Never commit real private keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Stripe, email, etc. — see existing deployment docs

# ---------------------------------------------------------------------------
# Supabase Auth — Stage 3A staging activation (disabled by default)
# Production MUST keep SUPABASE_AUTH_ENABLED=false until cutover (Stage 5+).
# Do NOT point DATABASE_URL at Supabase PostgreSQL (Neon stays until Stage 4).
# Staging: dedicated non-production Supabase project + Neon staging DB.
# Placeholders only — never commit real secrets.
# See docs/supabase-migration-stage-3a.md
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_ENABLED=false
# VECTORWORK_STAGING_AUTH_INTEGRATION=true  # only for real staging e2e job
