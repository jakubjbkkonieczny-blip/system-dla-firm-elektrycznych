# Database
DATABASE_URL=
DIRECT_URL=
# Staging on Supabase Session pooler (Stage 4E+): append pool-safe Prisma params, e.g.
#   ?sslmode=require&connection_limit=5&pool_timeout=20
# Keep connection_limit * concurrent processes below Session pool capacity (~15 on current plan).
# Direct host db.<ref>.supabase.co may be IPv6-only; Session pooler may be used for both URLs.

# Session
SESSION_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Never commit real private keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Stripe, email, etc. — see existing deployment docs

# ---------------------------------------------------------------------------
# Supabase Auth — Stage 3A staging activation (disabled by default)
# Production MUST keep SUPABASE_AUTH_ENABLED=false until cutover (Stage 5+).
# Do NOT point DATABASE_URL at Supabase PostgreSQL (Neon stays until Stage 4).
# Staging: dedicated non-production Supabase project + Neon staging DB.
# Placeholders only — never commit real secrets.
# See docs/supabase-migration-stage-3a.md
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_ENABLED=false
# VECTORWORK_STAGING_AUTH_INTEGRATION=true  # only for real staging e2e job

# ---------------------------------------------------------------------------
# Stage 4G-B / 4H — production migration operator config (placeholders only)
# Production Neon remains the business DB until Stage 4H.
# Production Supabase Auth stays disabled until Stage 4H Auth cutover.
# Never commit real secrets. Staging project ref must never be used here:
#   yzezdhwffgamtmozmfse
# ---------------------------------------------------------------------------
# VECTORWORK_EXPECTED_PRODUCTION_PROJECT_REF=
# VECTORWORK_MIGRATION_ARTIFACT_DIR=  # default: ../vectorwork-migration-artifacts (outside git)
# Production Supabase env should live in a gitignored file such as:
#   .env.supabase-production
# with DATABASE_URL / DIRECT_URL / NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_SERVICE_ROLE_KEY
# and SUPABASE_AUTH_ENABLED=false until Stage 4H.
