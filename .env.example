# Database
DATABASE_URL=
DIRECT_URL=

# Session
SESSION_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Never commit real private keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Stripe, email, etc. — see existing deployment docs

# ---------------------------------------------------------------------------
# Supabase Auth — Stage 2A (disabled by default; legacy auth remains active)
# Do NOT set SUPABASE_AUTH_ENABLED=true in production until a later cutover.
# Do NOT point DATABASE_URL at Supabase PostgreSQL (Neon stays until Stage 4).
# Placeholders only — never commit real secrets.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_ENABLED=false
